# 复制本文件为 .env 并填入真实值（.env 绝对不能提交到 git！）

# 服务端口（Nginx 反向代理指向这里，本机只监听 127.0.0.1）
PORT=3000

# Supabase 项目配置（service_role key 在 Dashboard → Project Settings → API Keys）
# ⚠️ service_role 是管理员密钥，只能放在这台服务器的 .env 里，绝不放进 App 或 git
SUPABASE_URL=https://sratnkxbwsbvrewkdeii.supabase.co
SUPABASE_SERVICE_ROLE_KEY=粘贴你的service_role_key

# 时区（定时任务用；马来西亚）
TZ=Asia/Kuala_Lumpur

# 汇率：基准货币 + 每日刷新时间（cron，按上面时区执行）
RATES_BASE=MYR
RATES_REFRESH_CRON=0 7 * * *

# 每日记账提醒推播（需要 App 端注册过 push token 才有效）
PUSH_REMINDER_ENABLED=false
PUSH_REMINDER_CRON=0 14 * * *
